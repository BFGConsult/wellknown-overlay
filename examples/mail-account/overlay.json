{
  "mail_account": {
    "manual_setup": {
      "url": "https://autoconfig.example.org/mail/setup",
      "extra_sections": [
        {
          "title": "Password changes",
          "body_markdown": "Change your password in the [mail administration](https://admin.example.org/password)."
        }
      ]
    },
    "profiles": [
      {
        "match": "*+help@example.org",
        "domain": "example.org",
        "display_name": "Example Helpdesk",
        "display_short_name": "Helpdesk",
        "incoming": {
          "type": "imap",
          "hostname": "mail.example.org",
          "port": 993,
          "socket_type": "SSL",
          "authentication": "password-cleartext",
          "username": "help@example.org"
        },
        "outgoing": {
          "type": "smtp",
          "hostname": "mail.example.org",
          "port": 587,
          "socket_type": "STARTTLS",
          "authentication": "password-cleartext",
          "username": "help@example.org"
        }
      },
      {
        "match": "default",
        "domain": "example.org",
        "display_name": "Example Mail",
        "display_short_name": "Example",
        "incoming": {
          "type": "imap",
          "hostname": "mail.example.org",
          "port": 993,
          "socket_type": "SSL",
          "authentication": "password-cleartext",
          "username": "%EMAILADDRESS%"
        },
        "outgoing": {
          "type": "smtp",
          "hostname": "mail.example.org",
          "port": 587,
          "socket_type": "STARTTLS",
          "authentication": "password-cleartext",
          "username": "%EMAILADDRESS%"
        }
      }
    ]
  }
}
